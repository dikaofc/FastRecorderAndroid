<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemResultRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_neo_spinner"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvResultFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REC_20260901_120000.mp4"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/neo_black"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvResultUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="https://files.catbox.moe/example.mp4"
        android:textSize="12sp"
        android:textColor="#333333"
        android:background="#15000000"
        android:padding="8dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCopySingleLink"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="COPY LINK"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/neo_white"
            android:background="@drawable/bg_neo_toggle_on"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/btnOpenSingleLink"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="OPEN"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"
            android:background="@drawable/bg_neo_button"/>
    </LinearLayout>

</LinearLayout>
