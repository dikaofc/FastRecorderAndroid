<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogResultsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_neo_card"
    android:padding="20dp"
    android:layout_margin="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_cloud_upload"
            app:tint="@color/neo_black"
            android:layout_marginEnd="10dp"
            android:contentDescription="Upload Success"/>

        <TextView
            android:id="@+id/tvResultsTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="UPLOAD COMPLETE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your videos are ready on Catbox cloud."
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="14dp"/>

    <!-- Results List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUploadResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:layout_marginBottom="14dp"/>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnCopyAllLinks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="COPY ALL LINKS"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/neo_white"
            android:background="@drawable/bg_neo_toggle_on"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/btnCloseResults"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="DONE"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"
            android:background="@drawable/bg_neo_button"/>
    </LinearLayout>

</LinearLayout>
