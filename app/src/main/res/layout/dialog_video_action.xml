<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogActionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_neo_card"
    android:padding="20dp"
    android:layout_margin="16dp">

    <!-- Header with thumbnail and video name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#22000000"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/ivActionThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Video Thumbnail"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/neo_white"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvActionFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REC_20260901_120000.mp4"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/neo_black"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/tvActionFileSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="14.2 MB"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Play Video -->
        <LinearLayout
            android:id="@+id/btnActionPlay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_neo_toggle_on"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/neo_white"
                android:layout_marginEnd="8dp"
                android:contentDescription="Play"/>

            <TextView
                android:id="@+id/tvActionPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAY VIDEO"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/neo_white"/>
        </LinearLayout>

        <!-- Video Info (Technical details) -->
        <LinearLayout
            android:id="@+id/btnActionInfo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_neo_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivActionInfoIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                app:tint="@color/neo_black"
                android:layout_marginEnd="8dp"
                android:contentDescription="Info"/>

            <TextView
                android:id="@+id/tvActionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TECHNICAL INFO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neo_black"/>
        </LinearLayout>

        <!-- Rename -->
        <LinearLayout
            android:id="@+id/btnActionRename"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_neo_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivActionRenameIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/neo_black"
                android:layout_marginEnd="8dp"
                android:contentDescription="Rename"/>

            <TextView
                android:id="@+id/tvActionRename"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RENAME FILE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neo_black"/>
        </LinearLayout>

        <!-- Upload to Catbox -->
        <LinearLayout
            android:id="@+id/btnActionUpload"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_neo_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivActionUploadIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cloud_upload"
                app:tint="@color/neo_black"
                android:layout_marginEnd="8dp"
                android:contentDescription="Upload"/>

            <TextView
                android:id="@+id/tvActionUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPLOAD TO CATBOX"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neo_black"/>
        </LinearLayout>

        <!-- Delete (Danger) -->
        <LinearLayout
            android:id="@+id/btnActionDelete"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_neo_button_danger"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/neo_white"
                android:layout_marginEnd="8dp"
                android:contentDescription="Delete"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELETE RECORDING"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/neo_white"/>
        </LinearLayout>

        <!-- Cancel / Dismiss -->
        <TextView
            android:id="@+id/btnActionCancel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="CANCEL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"
            android:background="@drawable/bg_neo_button"/>
    </LinearLayout>

</LinearLayout>
