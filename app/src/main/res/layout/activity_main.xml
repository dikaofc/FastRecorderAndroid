<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_yellow"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- HEADER: FAST RECORDER + gear -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FAST RECORDER"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:textColor="@color/neo_black"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        app:layout_constraintHorizontal_bias="0"/>

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:background="@drawable/bg_neo_button"
        android:src="@drawable/ic_settings"
        app:tint="@color/neo_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btnDev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_neo_button"
        android:gravity="center"
        android:text="!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/neo_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        android:layout_marginEnd="8dp"/>

    <!-- divider -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="@color/neo_black"
        android:layout_marginTop="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- TIMER BLOCK centered -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:textColor="@color/neo_black"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- badge READY / RECORDING -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● READY"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:textColor="@color/neo_white"
        android:background="@drawable/bg_pill_black"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- INFO CARD 2x2 grid — more informative -->
    <LinearLayout
        android:id="@+id/configCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_neo_card"
        android:padding="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- keep legacy IDs hidden for compat, new grid visible -->
        <TextView
            android:id="@+id/tvResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/tvAudioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESOLUTION"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/tvResValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="720p HD"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/neo_black"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <View
                android:layout_width="1.5dp"
                android:layout_height="40dp"
                android:background="#1A0A0A0A"
                android:layout_gravity="center_vertical"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRAME RATE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/tvFpsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 FPS"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/neo_black"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#1A0A0A0A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUDIO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/tvAudioValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/neo_black"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <View
                android:layout_width="1.5dp"
                android:layout_height="40dp"
                android:background="#1A0A0A0A"
                android:layout_gravity="center_vertical"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOURCE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/tvSourceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTERNAL"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/neo_black"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM CONTROLS: gallery + REC sejajar visual -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="22dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/configCard"
        app:layout_constraintVertical_bias="1.0">

        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="18dp"
            android:background="@drawable/bg_neo_button"
            android:src="@drawable/ic_gallery"
            app:tint="@color/neo_black"/>

        <!-- spacer -->
        <View
            android:layout_width="20dp"
            android:layout_height="1dp"/>

        <FrameLayout
            android:id="@+id/btnRecContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- hard shadow offset -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_neo_rec_shadow"
                android:alpha="1.0"/>

            <View
                android:id="@+id/recPulse"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_neo_rec"
                android:alpha="0"/>

            <!-- inner ring when recording -->
            <View
                android:id="@+id/recRing"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_rec_ring"
                android:alpha="0"/>

            <View
                android:id="@+id/btnRec"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_neo_rec"/>

            <!-- center icon ● / ■ -->
            <TextView
                android:id="@+id/tvRecIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="●"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/neo_white"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
