<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_yellow"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZETA RECORDER"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/neo_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="11dp"
        android:background="@drawable/bg_neo_button"
        android:src="@drawable/ic_settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/neo_black"/>

    <!-- Timer -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/neo_black"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="READY"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/neo_black"
        app:layout_constraintTop_toBottomOf="@id/tvTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Config Card -->
    <LinearLayout
        android:id="@+id/configCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_neo_card"
        android:padding="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus">
        
        <TextView
            android:id="@+id/tvResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Res: 720p | FPS: 30"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"/>

        <TextView
            android:id="@+id/tvAudioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio: Microphone"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- REC Button -->
    <FrameLayout
        android:id="@+id/btnRecContainer"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp">
        
        <View
            android:id="@+id/recPulse"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_neo_rec"
            android:alpha="0"/>

        <View
            android:id="@+id/btnRec"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_neo_rec"/>
    </FrameLayout>

    <ImageView
        android:id="@+id/btnGallery"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="14dp"
        android:background="@drawable/bg_neo_button"
        android:src="@drawable/ic_gallery"
        app:layout_constraintBottom_toBottomOf="@id/btnRecContainer"
        app:layout_constraintTop_toTopOf="@id/btnRecContainer"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        app:tint="@color/neo_black"/>

</androidx.constraintlayout.widget.ConstraintLayout>
