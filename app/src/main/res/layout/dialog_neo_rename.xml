<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRenameRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_neo_card"
    android:padding="20dp"
    android:layout_margin="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/ivRenameIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/neo_black"
            android:layout_marginEnd="10dp"
            android:contentDescription="Rename"/>

        <TextView
            android:id="@+id/tvRenameTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="RENAME RECORDING"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvRenameDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter a new name for the video file:"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="10dp"/>

    <!-- Text Input -->
    <EditText
        android:id="@+id/etNewFileName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_neo_input"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:textColor="@color/neo_black"
        android:textStyle="bold"
        android:singleLine="true"
        android:inputType="text"
        android:hint="Video_Name"
        android:textColorHint="#888888"
        android:layout_marginBottom="18dp"/>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSubmitRename"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="SAVE"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/neo_white"
            android:background="@drawable/bg_neo_toggle_on"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/btnCancelRename"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="CANCEL"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/neo_black"
            android:background="@drawable/bg_neo_button"/>
    </LinearLayout>

</LinearLayout>
