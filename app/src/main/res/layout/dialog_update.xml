<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE AVAILABLE"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#0A0A0A" />

    <TextView
        android:id="@+id/tvUpdateVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="v1.0.60 → v1.0.61"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvUpdateSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="12.3 MB"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvChangelogLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Changelog:"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#0A0A0A"
        android:layout_marginTop="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="180dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_neo_spinner">

        <TextView
            android:id="@+id/tvChangelog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="..."
            android:textSize="12sp"
            android:textColor="#333333" />
    </ScrollView>

    <!-- Progress -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvProgressLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading... 0%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0A0A0A" />

        <FrameLayout
            android:id="@+id/progressContainer"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:background="@drawable/bg_neo_progress_container"
            android:padding="2dp"
            android:layout_marginTop="6dp">

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_neo_progress_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProgressBytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0 MB"
            android:textSize="10sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvDownloadPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saved to: ..."
            android:textSize="10sp"
            android:textColor="#666666"
            android:singleLine="false"
            android:ellipsize="middle"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="LATER"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#0A0A0A"
            android:background="@drawable/bg_neo_spinner"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnDownload"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="DOWNLOAD"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_neo_toggle_on" />

        <TextView
            android:id="@+id/btnInstall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="INSTALL"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_neo_toggle_on"
            android:visibility="gone" />

    </LinearLayout>

    <CheckBox
        android:id="@+id/cbDeleteAfterInstall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete APK after update (save storage)"
        android:textSize="12sp"
        android:textColor="#333333"
        android:layout_marginTop="10dp"
        android:checked="true" />

    <TextView
        android:id="@+id/btnOpenFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁 Show file location — tap to copy path"
        android:textSize="11sp"
        android:textColor="#0066CC"
        android:padding="8dp"
        android:visibility="gone"
        android:gravity="center" />

</LinearLayout>
